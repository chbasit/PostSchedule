# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser.
# Never commit .env.local and never paste these values into chats or tickets.

# Public URL of this site (canonical URLs, email links, checkout return).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://agentiqsocial.com

# Development or production mode (README "Development and production mode"). Leave empty:
# `npm run dev` is development (sign-up and reset codes on screen, no email sent) and a
# production build is production (codes emailed). "production" makes `npm run dev` email too.
NEXT_PUBLIC_APP_MODE=

# Where the API lives. Empty = this app itself (app/api/v1), the normal case.
NEXT_PUBLIC_API_URL=
# "true" = in-browser sample data instead of the backend (landing recordings, demos only).
NEXT_PUBLIC_MOCK_API=false

# --- Supabase (database and sign-in) -------------------------------------------------
# Hosted: Project Settings > API Keys (the legacy anon / service_role keys work too).
# Local: `npm run db:start` prints them.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# "Publishable key" (sb_publishable_...). Safe in the browser; row-level security protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). Server only: it bypasses row-level security.
SUPABASE_SECRET_KEY=
# Only for applying migrations from this machine (npx supabase db push --db-url ...):
# Connect > Session pooler connection string, with your database password filled in.
SUPABASE_DB_URL=

# Google sign-in: "true" once the Google provider is enabled in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH=false
# Only for the local Supabase stack (supabase/config.toml reads them).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Lemon Squeezy (payments) ----------------------------------------------------------
# Settings > API. Use a test-mode key until launch.
LEMONSQUEEZY_API_KEY=
# Settings > Stores: the numeric store id.
LEMONSQUEEZY_STORE_ID=
# Settings > Webhooks: the signing secret you choose for https://<site>/api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant id for each plan and billing interval (Products > the variant's id).
LEMONSQUEEZY_VARIANTS={"solo:month":"","solo:year":"","pro:month":"","pro:year":"","agency:month":"","agency:year":"","scale:month":"","scale:year":""}
# "true" while testing: checkouts use test cards and live webhooks are not expected.
LEMONSQUEEZY_TEST_MODE=true

# --- AI (AI Studio images and the caption writer) --------------------------------------
# "true" turns AI on. Anything else shows "Coming soon" everywhere and the AI routes refuse
# requests, whatever keys are set below.
NEXT_PUBLIC_AI_ENABLED=false
# Which service does each job: "openai" or "gemini". Only the chosen service's key is needed.
AI_IMAGE_PROVIDER=openai
AI_TEXT_PROVIDER=openai
# platform.openai.com > API keys. Needs access to the image model (organisation verification).
OPENAI_API_KEY=
# aistudio.google.com > Get API key (a Google Cloud project with billing for image models).
GEMINI_API_KEY=
# Optional model overrides. Defaults: gpt-image-1 / gpt-4.1-mini, or gemini-2.5-flash-image / gemini-2.5-flash.
AI_IMAGE_MODEL=
AI_TEXT_MODEL=
# Private Supabase Storage bucket for generated images; created automatically on first use.
AI_STORAGE_BUCKET=ai-images
